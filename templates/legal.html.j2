<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page_title }} | {{ product_name }}</title>
<meta name="description" content="{{ page_title }} for {{ product_name }}.">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href="{{ meta.domain }}/{{ page_slug }}">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
<link rel="icon" href="assets/images/{{ slug }}-favicon.webp" type="image/webp">
</head>
<body>
<nav class="navbar navbar-light bg-white shadow-sm">
  <div class="container"><a class="navbar-brand fw-bold" href="index.html">{{ product_name }}</a></div>
</nav>
<main class="container py-5">
  <h1>{{ page_title }}</h1>
  <p class="text-muted">Last updated: {{ today }}</p>
  {{ body | safe }}
  <p class="mt-4"><a href="index.html">&larr; Back to Home</a></p>
</main>
<footer class="py-4 bg-dark text-white-50 text-center small">
  <div class="container"><p>&copy; {{ year }} {{ business_name }}. All rights reserved.</p></div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
