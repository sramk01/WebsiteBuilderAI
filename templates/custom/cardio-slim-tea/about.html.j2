<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="assets/images/{{ slug }}-favicon.webp" type="image/x-icon" />
  <meta name="description" content="{{ meta.description }}" />
  <meta name="keywords" content="{{ meta.keywords }}" />
  <link rel="canonical" href="{{ domain }}/about.html" />
  <title>{{ product_name }} | About</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="assets/css/mystyle.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg title-container sticky-top bg-color">
    <div class="container">
      <a class="navbar-brand fs-2 fw-bold text-white text-uppercase" href="index.html">{{ product_name }}</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link active text-white fs-3" href="about.html">About</a></li>
          <li class="nav-item"><a class="nav-link text-white fs-3" href="benefits.html">Benefits</a></li>
          <li class="nav-item"><a class="nav-link text-white fs-3" href="pricing.html">Pricing</a></li>
        </ul>
        <a href="order.html"><button class="btn btn-lg all-btn fs-2 fw-bold text-uppercase">{{ cta_label }}</button></a>
      </div>
    </div>
  </nav>

  <section class="bg-color pt-5 pb-5">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-5 col-md-5 col-sm-12">
          <img class="img-fluid" src="assets/images/{{ slug }}-product-main.webp" alt="{{ product_name }}" />
        </div>
        <div class="col-lg-7 col-md-7 col-sm-12 text-white">
          <h1 class="fw-bold fs-1">{{ custom.what_is.title or ('About ' ~ product_name) }}</h1>
          {{ custom.what_is.body | safe }}
          <a href="order.html"><button class="btn btn-lg all-btn fw-bold fs-2 text-uppercase">{{ cta_label }}</button></a>
        </div>
      </div>
    </div>
  </section>

  <section class="title-container p-4">
    <h2 class="fw-bold text-center text-white fs-1">{{ custom.how_it_works.title }}</h2>
  </section>
  <section class="container mt-4 mb-5">
    {{ custom.how_it_works.body | safe }}
    {% if custom.how_it_works['items'] %}
    <div class="row g-4 mt-3">
      {% for item in custom.how_it_works['items'] %}
      <div class="col-md-4">
        <h3 class="fw-bold fs-4">{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </section>

  <section class="mt-5 mb-5 bg-color pt-5 pb-5">
    <div class="container bg-white pt-5 pb-5 rounded-5">
      <div class="row d-flex justify-content-center align-items-center">
        <div class="col-lg-8 col-md-8 col-sm-12">
          <h2 class="fw-bold mb-4 fs-1">{{ custom.guarantee.title }}</h2>
          {{ custom.guarantee.body | safe }}
          <a href="order.html"><button class="btn btn-lg all-btn fw-bold fs-2 text-uppercase">{{ cta_label }}</button></a>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12">
          <img class="img-fluid" src="assets/images/{{ slug }}-guarantee.webp" alt="{{ product_name }} guarantee" />
        </div>
      </div>
    </div>
  </section>

  <footer class="title-container pt-5 pb-5">
    <div class="container">
      <h2 class="text-center text-white fw-bold">{{ custom.conclusion.title or product_name }}</h2>
      <div class="text-center text-white mt-4">{{ custom.conclusion.body | safe }}</div>
      <ul class="footer-menu mt-4">
        <li><a href="privacy-policy.html">Privacy Policy</a></li>
        <li><a href="disclaimer.html">Disclaimer</a></li>
        <li><a href="terms-and-conditions.html">Terms and Conditions</a></li>
      </ul>
      <p class="text-center text-white mt-4 fs-5 fw-bold">&copy; Copyright {{ year }} <a href="index.html" class="text-uppercase text-white">{{ product_name }}.</a> All Rights Reserved.</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
