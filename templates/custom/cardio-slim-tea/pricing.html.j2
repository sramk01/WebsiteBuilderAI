<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="shortcut icon"
      href="assets/images/{{ slug }}-favicon.webp"
      type="image/x-icon"
    />
    <meta
      name="description"
      content="Read the Privacy Policy for {{ product_name }} to learn how we protect your personal information, data security, and ensure safe online transactions."
    />
    <meta
      name="keywords"
      content="{{ product_name }}, {{ product_name }} Support, {{ product_name }} buy, {{ product_name }} Heart Supplement, {{ product_name }} official website, {{ product_name }} heart support"
    />
    <meta
      name="robots"
      content="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
    />
    <link
      rel="canonical"
      href="{{ domain }}/privacy-policy.html"
    />
    <title>Privacy Policy | {{ product_name }} | Official Website</title>

    <!--Og Tag-->
    <meta
      property="og:title"
      content="Privacy Policy | {{ product_name }} | Official Website"
    />
    <meta
      property="og:description"
      content="Read the Privacy Policy for {{ product_name }} to learn how we protect your personal information, data security, and ensure safe online transactions."
    />
    <meta property="og:image" content="assets/images/{{ slug }}-og-image.webp" />
    <meta
      property="og:url"
      content="{{ domain }}/privacy-policy.html"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ product_name }}" />

    <!--Twitter Card Meta Tags-->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="Privacy Policy | {{ product_name }} | Official Website"
    />
    <meta
      name="twitter:description"
      content="Read the Privacy Policy for {{ product_name }} to learn how we protect your personal information, data security, and ensure safe online transactions."
    />
    <meta name="twitter:image" content="assets/images/{{ slug }}-og-image.webp" />
    <meta
      name="twitter:url"
      content="{{ domain }}/privacy-policy.html"
    />
    <meta name="twitter:site" content="{{ product_name }}" />

    <!-- fontawesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
      integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <!-- style start -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />

    <link rel="stylesheet" href="assets/css/mystyle.css" />
    <!-- style end -->
  </head>

  <body>
    <!-- navbar section -->
    <nav class="navbar navbar-expand-lg title-container sticky-top bg-color">
      <div class="container">
        <a class="navbar-brand fs-2 fw-bold text-white text-uppercase" href="/"
          >{{ product_name }}</a
        >
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarSupportedContent"
          aria-controls="navbarSupportedContent"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a
                class="nav-link active text-white fs-3"
                aria-current="page"
                href="about.html"
                >About {{ product_name }}</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link text-white fs-3" href="benefits.html"
                >Benefits</a
              >
            </li>
            <li class="nav-item">
              <a class="nav-link text-white fs-3" href="pricing.html"
                >Pricing</a
              >
            </li>
          </ul>
          <a href="#pricing">
            <button class="btn btn-lg all-btn fs-2 fw-bold text-uppercase">
              Order Now
            </button>
          </a>
        </div>
      </div>
    </nav>

    <section class="container mt-4">
      <h1 class="fw-bold fs-1">Choose Your {{ product_name }} Savings Package</h1>
      <p>
        Pick the package that fits your goals and enjoy exclusive discounts,
        free shipping, and a risk-free 60-day guarantee.
      </p>

      <p class="fw-bold mt-4">Basic Package</p>
      <ul>
        <li>{{ currency_symbol }}{{ price.one_bottle }} per Pouch</li>
        <li>+ Shipping Fee*</li>
        <li>2 Pouch – 60 Day Supply</li>
        <li>Total Savings: <del>$298</del> → {{ currency_symbol }}{{ price.one_bottle }}</li>
      </ul>

      <p class="fw-bold mt-4">Premium Package – 3 Pouch (Best Value!)</p>
      <ul>
        <li>{{ currency_symbol }}{{ price.three_bottle_each }} per Pouch</li>
        <li>Free Shipping*</li>
        <li>3 Pouch – 90 Day Supply</li>
        <li>Total Savings: <del>$447</del> → {{ currency_symbol }}{{ price.three_bottle_each }}</li>
      </ul>

      <p class="fw-bold mt-4">Standard Package – 6 Bottles</p>
      <ul>
        <li>{{ currency_symbol }}{{ price.one_bottle }} per Pouch</li>
        <li>Free Shipping*</li>
        <li>6 Pouch – 180 Day Supply</li>
        <li>Total Savings: <del>{{ currency_symbol }}{{ price.six_bottle_each }}</del> → {{ currency_symbol }}{{ price.six_bottle_each }}</li>
      </ul>
    </section>

    <!-- title -->
    <section class="title-container p-4">
      <h2 class="fw-bold text-center text-white fs-1">
        Don't Miss Out Purchase and Save Discount on {{ product_name }}?
      </h2>
    </section>

    <!-- title -->
    <section class="title-container p-4">
      <h2 class="fw-bold text-center text-white fs-1">
        Don't Miss Out Purchase and Save Discount on {{ product_name }}?
      </h2>
    </section>

    <!-- {{ product_name }} Price 2 -->
    <section class="bg-tartiary-color">
      <div class="container pt-5 pb-5 text-center">
        <div class="row">
          <div class="col-lg-12 col-md-12">
            <a href="order.html">
              <img
                class="img-fluid"
                src="assets/images/{{ slug }}-pricing.webp"
                alt="{{ product_name }} Price 1"
              />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- title -->
    <section class="title-container mt-5 p-4">
      <h2 class="fw-bold text-center text-white fs-1">
        Don't Wait Any Longer! Order Discounted {{ product_name }} Now!
      </h2>
    </section>

    <section class="container text-center mb-5" id="discount-section">
      <div class="row d-flex align-items-center justify-content-center">
        <div class="col-lg-6 col-sm-12">
          <img
            class="img-fluid"
            src="assets/images/{{ slug }}-product-package-3.webp"
            alt="Discounted {{ product_name }} Now"
          />
          <p class="text-center mt-5 fs-1">
            <strong>Regular Price: </strong><del>$99/Pouch</del>
          </p>
          <p class="text-center fs-2">
            <strong>Today Just For: </strong>{{ currency_symbol }}{{ price.one_bottle }}/ Pouch
          </p>
          <a href="order.html">
            <button class="btn btn-lg all-btn text-uppercase fs-2 fw-bold">
              Get {{ product_name }} Now!
            </button>
          </a>
        </div>
      </div>
    </section>

    <!-- foooter section -->
    <footer class="title-container pt-5 pb-5" id="footer">
      <div class="container">
        <h2 class="text-center text-white fw-bold">Conclusion</h2>
        <p class="text-center text-white mt-4">
          {{ product_name }} is a natural, plant-based solution designed to support
          healthy blood pressure, improve circulation, and aid in weight
          management. With its carefully selected ingredients, daily use can
          promote energy, reduce bloating, and enhance overall wellness. Backed
          by a 60-day money-back guarantee, it offers a safe and convenient way
          to support your heart and body naturally.
        </p>

        <ul class="footer-menu mt-4">
          <li><a href="privacy-policy.html">Privacy Policy</a></li>
          <li><a href="disclaimer.html">Disclaimer</a></li>
          <li><a href="terms-and-conditions.html">Terms and Conditions</a></li>
        </ul>

        <p class="text-center text-white mt-4 fs-5 fw-bold">
          © Copyright 2025
          <a href="/" class="text-uppercase text-white">{{ product_name }}.</a> All
          Rights Reserved.
        </p>
      </div>
    </footer>

    <!-- js -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"
    ></script>
    <script src="assets/js/myscript.js"></script>
  </body>
</html>
