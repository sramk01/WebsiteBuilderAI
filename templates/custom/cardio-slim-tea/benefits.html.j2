<!DOCTYPE html>
<html lang="en-US">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="assets/images/{{ slug }}-favicon.webp" type="image/x-icon" />
  <meta name="description" content="{{ meta.description }}" />
  <meta name="keywords" content="{{ meta.keywords }}" />
  <link rel="canonical" href="{{ domain }}/benefits.html" />
  <title>{{ product_name }} | Benefits</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="assets/css/mystyle.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg title-container sticky-top bg-color">
    <div class="container">
      <a class="navbar-brand fs-2 fw-bold text-white text-uppercase" href="index.html">{{ product_name }}</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
          <li class="nav-item"><a class="nav-link text-white fs-3" href="about.html">About</a></li>
          <li class="nav-item"><a class="nav-link active text-white fs-3" href="benefits.html">Benefits</a></li>
          <li class="nav-item"><a class="nav-link text-white fs-3" href="pricing.html">Pricing</a></li>
        </ul>
        <a href="order.html"><button class="btn btn-lg all-btn fs-2 fw-bold text-uppercase">{{ cta_label }}</button></a>
      </div>
    </div>
  </nav>

  <section class="title-container p-4">
    <h1 class="fw-bold text-center text-white fs-1">{{ custom.benefits.title or ('The Key Benefits of ' ~ product_name) }}</h1>
  </section>
  <section class="container mt-5 mb-5">
    {{ custom.benefits.body | safe }}
    {% if custom.benefits['items'] %}
    <ul>
      {% for item in custom.benefits['items'] %}
      <li><i class="fa-solid fa-circle-check"></i> <strong>{{ item.title }}:</strong> {{ item.text }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>

  <section class="title-container p-4">
    <h2 class="fw-bold text-center text-white fs-1">{{ custom.ingredients.title or ('Inside ' ~ product_name) }}</h2>
  </section>
  <section class="container mt-4 mb-5">
    {{ custom.ingredients.body | safe }}
    {% for item in custom.ingredients['items'] %}
    <p><i class="fa-solid fa-circle-check"></i> <strong>{{ item.title }}:</strong> {{ item.text }}</p>
    {% endfor %}
  </section>

  <section class="title-container p-4">
    <h2 class="fw-bold text-center text-white fs-1">{{ custom.pros_cons.title or (product_name ~ ' Pros & Cons') }}</h2>
  </section>
  <section class="container mt-4 mb-5">
    {{ custom.pros_cons.body | safe }}
    <p class="fw-bold">Pros:</p>
    <ul style="list-style-type: none; padding-left: 0">
      {% for item in custom.pros_cons.pros %}<li>{{ item }}</li>{% endfor %}
    </ul>
    <p class="fw-bold mt-4">Cons:</p>
    <ul style="list-style-type: none; padding-left: 0">
      {% for item in custom.pros_cons.cons %}<li>{{ item }}</li>{% endfor %}
    </ul>
  </section>

  <section class="title-container p-4">
    <h2 class="fw-bold text-center text-white fs-1">{{ custom.testimonials.title or 'What Customers Are Saying' }}</h2>
  </section>
  <section class="container mt-5 mb-5">
    {% for item in custom.testimonials['items'][:3] %}
    <div class="row align-items-center mb-5 {% if loop.index is even %}flex-lg-row-reverse{% endif %}">
      <div class="col-lg-3 col-md-3 col-sm-12">
        <img class="img-fluid rounded" src="assets/images/{{ slug }}-customer-review-{{ loop.index }}.webp" alt="{{ product_name }} customer {{ loop.index }}" />
      </div>
      <div class="col-lg-9 col-md-9 col-sm-12">
        <h3 class="fw-bold">{{ item.title or item.name }}</h3>
        <p>{{ item.quote or item.text }}</p>
        <button class="btn btn-lg all-btn fs-4 fw-bold text-uppercase">{{ item.name }}{% if item.role %}, {{ item.role }}{% endif %}</button>
      </div>
    </div>
    {% endfor %}
  </section>

  <footer class="title-container pt-5 pb-5">
    <div class="container">
      <h2 class="text-center text-white fw-bold">{{ custom.conclusion.title or product_name }}</h2>
      <div class="text-center text-white mt-4">{{ custom.conclusion.body | safe }}</div>
      <ul class="footer-menu mt-4">
        <li><a href="privacy-policy.html">Privacy Policy</a></li>
        <li><a href="disclaimer.html">Disclaimer</a></li>
        <li><a href="terms-and-conditions.html">Terms and Conditions</a></li>
      </ul>
      <p class="text-center text-white mt-4 fs-5 fw-bold">&copy; Copyright {{ year }} <a href="index.html" class="text-uppercase text-white">{{ product_name }}.</a> All Rights Reserved.</p>
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
