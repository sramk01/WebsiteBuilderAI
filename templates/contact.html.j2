<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Us | {{ product_name }}</title>
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ meta.domain }}/contact.html">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="assets/css/style.css">
<link rel="icon" href="assets/images/{{ slug }}-favicon.webp" type="image/webp">
</head>
<body>
<nav class="navbar navbar-light bg-white shadow-sm">
  <div class="container"><a class="navbar-brand fw-bold" href="index.html">{{ product_name }}</a></div>
</nav>
<main class="container py-5">
  <h1>Contact Us</h1>
  <p>Have a question about your order or {{ product_name }}? Reach out and our support team will get back to you.</p>
  <p>Email: <a href="mailto:{{ contact_email }}">{{ contact_email }}</a></p>
  <form>
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Message</label>
      <textarea class="form-control" rows="4" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send Message</button>
    <p class="form-text">Note: connect this form to a backend (e.g. Formspree, your own API) — it does not submit anywhere by default.</p>
  </form>
  <p class="mt-4"><a href="index.html">&larr; Back to Home</a></p>
</main>
<footer class="py-4 bg-dark text-white-50 text-center small">
  <div class="container"><p>&copy; {{ year }} {{ business_name }}. All rights reserved.</p></div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
